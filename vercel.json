{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/robots"
        },
        {
            "source": "/robot.txt",
            "destination": "/api/robots"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}